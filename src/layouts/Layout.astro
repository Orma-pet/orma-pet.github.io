---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { UI, BRAND } from '../data/site.js';
import '../styles/global.css';
// Font self-hostati (niente richiesta a Google → nessun cookie di terze parti).
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '@fontsource/nunito/900.css';

// props:
//  lang: 'it' | 'en' — pilota <html lang>
//  title, description — meta
//  active — chiave pagina per evidenziare il menu
//  altUrl — URL dell'equivalente nell'altra lingua (selettore lingua + hreflang)
//  noindex — booleano (per /pet)
const {
  lang = 'it',
  title,
  description = '',
  active = 'home',
  altUrl = '/',
  noindex = false,
} = Astro.props;

const ui = UI[lang];

// SEO: URL assoluti per canonical / hreflang / social.
const siteUrl = BRAND.siteUrl;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
const itHref = new URL(lang === 'it' ? Astro.url.pathname : altUrl, siteUrl).href;
const enHref = new URL(lang === 'en' ? Astro.url.pathname : altUrl, siteUrl).href;
const ogImage = new URL(BRAND.ogImage, siteUrl).href;
const ogLocale = lang === 'it' ? 'it_IT' : 'en_US';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#org`,
      name: 'Orma',
      url: siteUrl,
      email: BRAND.email,
      logo: new URL('/favicon.svg', siteUrl).href,
      founder: { '@type': 'Person', name: BRAND.owner },
      areaServed: 'IT',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Orma',
      url: siteUrl,
      inLanguage: lang === 'it' ? 'it-IT' : 'en-US',
      publisher: { '@id': `${siteUrl}/#org` },
    },
  ],
};
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script define:vars={{ altUrl, lang }}>
      // Reindirizzamento automatico alla lingua giusta, UNA volta sola.
      //
      // Attenzione: su hosting statico non si puo' sapere il PAESE di chi
      // arriva (servirebbe un servizio di geolocalizzazione IP, cioe' una
      // richiesta a terzi su ogni visita). Usiamo la lingua del browser, che
      // e' il segnale piu' vicino e non costa privacy a nessuno.
      (function () {
        try {
          // Nessuna pagina gemella, o e' questa stessa: niente da fare.
          if (!altUrl || altUrl === location.pathname) return;

          // I crawler non vanno spostati: si orientano con i tag hreflang.
          // Googlebot gira con l'inglese e finirebbe per non indicizzare mai
          // le pagine italiane.
          if (/bot|crawl|spider|slurp|preview|lighthouse/i.test(navigator.userAgent)) return;

          // Se l'utente ha scelto a mano dal selettore, la sua scelta vince
          // per sempre.
          if (localStorage.getItem('orma_lang')) return;

          // Una sola volta per sessione, cosi' non si combatte con il tasto
          // "indietro" del browser.
          if (sessionStorage.getItem('orma_lang_auto')) return;
          sessionStorage.setItem('orma_lang_auto', '1');

          // navigator.languages e' l'elenco ordinato per preferenza: usarlo
          // tutto invece del solo primo elemento evita di mandare in inglese
          // chi ha il sistema in inglese ma l'italiano come seconda lingua.
          var elenco = navigator.languages || [navigator.language || ''];
          var vuole = 'en';
          for (var i = 0; i < elenco.length; i++) {
            var l = String(elenco[i]).toLowerCase();
            if (l.indexOf('it') === 0) { vuole = 'it'; break; }
            if (l.indexOf('en') === 0) { vuole = 'en'; break; }
          }
          if (vuole !== lang) location.replace(altUrl);
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && <link rel="alternate" hreflang="it" href={itHref} />}
    {!noindex && <link rel="alternate" hreflang="en" href={enHref} />}
    {!noindex && <link rel="alternate" hreflang="x-default" href={itHref} />}

    {/* Open Graph + Twitter: anteprima quando si condivide il link */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orma" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {BRAND.cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${BRAND.cfAnalyticsToken}"}`}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <Header lang={lang} active={active} altUrl={altUrl} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
