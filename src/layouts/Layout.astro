---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { UI, BRAND, LANGS_PRONTE, ROUTES, urlPagina } from '../data/site.js';
import '../styles/global.css';
// Font self-hostati (niente richiesta a Google → nessun cookie di terze parti).
import '@fontsource/nunito/400.css';
import '@fontsource/nunito/600.css';
import '@fontsource/nunito/700.css';
import '@fontsource/nunito/800.css';
import '@fontsource/nunito/900.css';

// props:
//  lang: 'it' | 'en' — pilota <html lang>
//  title, description — meta
//  active — chiave pagina per evidenziare il menu
//  noindex — booleano (per /pet)
const {
  lang = 'it',
  title,
  description = '',
  active = 'home',
  noindex = false,
  // Pagine che NON hanno una gemella nelle altre lingue: /t (medaglietta),
  // /i (codice invito), /join. Vedi il commento sopra lo script piu' sotto.
  autoLang = true,
} = Astro.props;

const ui = UI[lang];

// SEO: URL assoluti per canonical / hreflang / social.
const siteUrl = BRAND.siteUrl;
const canonical = new URL(Astro.url.pathname, siteUrl).href;
// hreflang per TUTTE le lingue pubblicate, non solo "l'altra". `active` e'
// gia' la chiave di ROUTES che ogni pagina passa, quindi l'elenco si costruisce
// da solo: aggiungere una lingua a LANGS non richiede di toccare le pagine.
const alternative = LANGS_PRONTE.map((l) => ({
  code: l.code,
  href: new URL(urlPagina(active, l.code), siteUrl).href,
}));
// Dove mandare chi arriva con il browser in una lingua diversa da questa.
//
// Vuoto = non si sposta nessuno. Due casi, e sono ENTRAMBI successi:
//
//  1. `autoLang={false}`: la pagina non esiste nelle altre lingue. Spostare
//     uno di lingua vuol dire portarlo su un'ALTRA pagina, non sulla stessa
//     tradotta.
//  2. `active` non e' una chiave di ROUTES: urlPagina() in quel caso
//     restituisce '/' senza dire niente, e la tabella diventa "tutti alla
//     homepage". E' quello che faceva /t, che passa active="tag" mentre in
//     ROUTES una chiave "tag" non c'e' mai stata. Qui la mancanza si nota
//     invece di trasformarsi in un reindirizzamento sbagliato.
const perLingua =
  autoLang && ROUTES[active]
    ? Object.fromEntries(
        LANGS_PRONTE.map((l) => [l.code, urlPagina(active, l.code)]),
      )
    : {};
const ogImage = new URL(BRAND.ogImage, siteUrl).href;
const ogLocale = lang === 'it' ? 'it_IT' : 'en_US';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': `${siteUrl}/#org`,
      name: 'Orma',
      url: siteUrl,
      email: BRAND.email,
      logo: new URL('/favicon.svg', siteUrl).href,
      founder: { '@type': 'Person', name: BRAND.owner },
      areaServed: 'IT',
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      name: 'Orma',
      url: siteUrl,
      inLanguage: lang === 'it' ? 'it-IT' : 'en-US',
      publisher: { '@id': `${siteUrl}/#org` },
    },
  ],
};
---
<!DOCTYPE html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script is:inline>
      // Il banner di Apple in cima alla pagina, su iPhone.
      //
      // `is:inline` NON e' decorativo: senza, Astro impacchetta lo script come
      // modulo differito e questo gira DOPO che Safari ha gia' deciso se
      // mostrare il banner. Il tag finiva nel DOM e non serviva a niente.
      //
      // PERCHE' SERVE, visto che ci sono gia' i link universali
      // ---------------------------------------------------------
      // I link universali aprono l'app SOLO in certi contesti: da Messaggi,
      // da Note, da Mail, da un'altra app. NON scattano se l'indirizzo viene
      // digitato nella barra di Safari, ne' se si e' gia' su orma.pet e si
      // tocca un link allo stesso dominio (iOS lo impedisce di proposito,
      // altrimenti non si potrebbe navigare il sito di un'app installata).
      //
      // E soprattutto: i browser interni di WhatsApp, Facebook e Instagram si
      // tengono l'utente dentro la propria finestra. E' esattamente li' che
      // finisce un volantino condiviso -- cioe' il caso piu' frequente.
      // Il banner non copre tutti quei casi (nelle WKWebView non compare), ma
      // copre Safari, che e' dove la maggior parte delle persone atterra.
      //
      // app-argument porta all'app l'indirizzo COMPLETO, con la stringa di
      // interrogazione: senza, il banner aprirebbe Orma sulla sua schermata
      // iniziale e non sulla segnalazione. Per questo il tag si scrive da
      // qui e non nell'HTML: il sito e' statico, e `?id=` esiste solo nel
      // browser.
      //
      // Finche' l'app non e' pubblicata Safari non trova l'identificativo e
      // semplicemente non mostra niente: nessun danno, e il giorno della
      // pubblicazione si accende da solo.
      document.head.insertAdjacentHTML(
        'beforeend',
        '<meta name="apple-itunes-app" content="app-id=6786283294, app-argument='
          + encodeURI(location.href) + '">',
      );
    </script>
    <script define:vars={{ perLingua, lang }}>
      // Reindirizzamento automatico alla lingua giusta, UNA volta sola.
      //
      // NON VALE PER TUTTE LE PAGINE. Le tre pagine che ricevono un
      // identificativo da fuori — /t (medaglietta), /i (codice invito),
      // /join — esistono solo in italiano, e "mandare alla versione giusta"
      // li' significava mandare alla HOMEPAGE di quella lingua. Chi trovava
      // un cane in Germania e scansionava la medaglietta finiva sulla
      // presentazione di Orma: non l'animale, non un errore, la vetrina.
      // Quelle pagine passano autoLang={false} e perLingua arriva qui vuoto.
      //
      // Su hosting statico non si puo' sapere il PAESE di chi arriva
      // (servirebbe un servizio di geolocalizzazione IP, cioe' una richiesta a
      // terzi su ogni visita). Usiamo la lingua del browser: e' il segnale piu'
      // vicino e non costa privacy a nessuno.
      (function () {
        try {
          // I crawler non vanno spostati: si orientano con i tag hreflang.
          // Googlebot gira in inglese e non indicizzerebbe mai le altre lingue.
          if (/bot|crawl|spider|slurp|preview|lighthouse/i.test(navigator.userAgent)) return;

          // Una sola volta per sessione: cosi' non si combatte con il tasto
          // "indietro" del browser.
          if (sessionStorage.getItem('orma_lang_auto')) return;
          sessionStorage.setItem('orma_lang_auto', '1');

          // La CODA DELL'INDIRIZZO va portata dietro, sempre.
          //
          // Non e' un dettaglio: e' tutto il contenuto della pagina. Su /pet
          // l'`?id=` E' la segnalazione, su /t il `?tk=` E' la medaglietta,
          // su /i il `?c=` E' il codice invito. Spostando qualcuno di lingua
          // senza la coda si ottiene la pagina giusta e vuota: chi ha appena
          // scansionato il QR di un cane smarrito vede la presentazione di
          // Orma invece del cane, e non gli compare nessun errore che glielo
          // spieghi. Succedeva a chiunque avesse il browser in una lingua
          // diversa da quella della pagina — cioe', dopo il lancio globale,
          // alla maggioranza.
          var coda = location.search + location.hash;

          // Il confronto va fatto senza la barra finale: GitHub Pages
          // reindirizza /pet a /pet/, quindi location.pathname ha la barra e
          // urlPagina() no. Confrontarli cosi' com'e' li darebbe sempre per
          // diversi.
          var nudo = function (u) { return u.replace(/\/+$/, '') || '/'; };

          // navigator.languages e' l'elenco ordinato per preferenza: scorrerlo
          // tutto evita di mandare in inglese chi ha il sistema in inglese ma
          // la propria lingua al secondo posto.
          var elenco = navigator.languages || [navigator.language || ''];
          for (var i = 0; i < elenco.length; i++) {
            var codice = String(elenco[i]).toLowerCase().split('-')[0];
            if (!perLingua[codice]) continue;      // lingua non pubblicata
            if (codice === lang) return;           // siamo gia' quella giusta
            if (nudo(perLingua[codice]) === nudo(location.pathname)) return;
            location.replace(perLingua[codice] + coda);
            return;
          }
        } catch (e) {}
      })();
    </script>
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {!noindex && <link rel="canonical" href={canonical} />}
    {!noindex && alternative.map((a) => (
      <link rel="alternate" hreflang={a.code} href={a.href} />
    ))}
    {!noindex && <link rel="alternate" hreflang="x-default" href={alternative[0].href} />}

    {/* Open Graph + Twitter: anteprima quando si condivide il link */}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Orma" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    {description && <meta name="twitter:description" content={description} />}
    <meta name="twitter:image" content={ogImage} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    {BRAND.cfAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${BRAND.cfAnalyticsToken}"}`}
      ></script>
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">{ui.skipToContent}</a>
    <Header lang={lang} active={active} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
  </body>
</html>
