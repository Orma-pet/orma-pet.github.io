---
import Layout from '../../layouts/Layout.astro';
import { UI, ROUTES } from '../../data/site.js';
import { GUIDES } from '../../data/guides.js';

const lang = 'it';
const ui = UI[lang];
const base = ROUTES.guides[lang];
---
<Layout
  lang={lang}
  title={`Orma — ${ui.guidesHubTitle}`}
  description={ui.guidesHubLead}
  active="guides"
  altUrl={ROUTES.guides.en}
>
  <section class="section">
    <div class="wrap">
      <div class="section__head">
        <span class="eyebrow">Guide</span>
        <h1>{ui.guidesHubTitle}</h1>
        <p class="section__lead">{ui.guidesHubLead}</p>
      </div>
      <ul class="guide-list">
        {GUIDES.map((g) => (
          <li>
            <a href={base + g.slug[lang] + '/'}>
              <strong>{g[lang].title}</strong>
              <span>{g[lang].metaDesc}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</Layout>
