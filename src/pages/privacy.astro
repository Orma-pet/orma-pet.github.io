---
import LegalPage from '../components/LegalPage.astro';
import { LEGAL } from '../data/legal.js';
import { ROUTES } from '../data/site.js';

const lang = 'it';
const doc = LEGAL.privacy;
---
<LegalPage
  lang={lang}
  title={doc.title.it}
  description="Come Orma raccoglie e tratta i tuoi dati personali: finalità, basi giuridiche, fornitori, conservazione e diritti GDPR."
  html={doc.html.it}
  active="privacy"
  homeUrl={ROUTES.home[lang]}
/>
