---
import Layout from '../layouts/Layout.astro';
import StoreButtons from '../components/StoreButtons.astro';
// Pagina di atterraggio INVITO A CO-GESTIRE UN ANIMALE. Il link è
// https://orma.pet/join?tk=<token>. L'invito viene poi abbinato in app alla
// TUA email: basta installare e accedere con l'email a cui è arrivato l'invito.
const title = 'Invito a gestire un animale · Orma';
---
<Layout lang="it" title={title} active="home" altUrl="/join" noindex={true}>
  <section class="invite">
    <div class="invite__box">
      <div class="invite__icon" aria-hidden="true">🐾</div>
      <h1>Ti hanno invitato a gestire un animale</h1>
      <p class="invite__sub">
        Qualcuno vuole condividere con te la scheda di un animale su Orma:
        stesso libretto, stesso codice QR, avvisi se si smarrisce.
        <br /><span class="invite__en">You've been invited to co-manage a pet on Orma.</span>
      </p>

      <StoreButtons lang="it" android="Google Play" ios="App Store" variant="dark" />

      <ol class="invite__steps">
        <li>Scarica Orma e accedi (o iscriviti) con l'email a cui hai ricevuto l'invito.</li>
        <li>In "I miei animali" comparirà l'invito: tocca "Accetta".</li>
        <li>Da quel momento gestisci l'animale insieme al proprietario.</li>
      </ol>
    </div>
  </section>

  <style>
    .invite { max-width: 560px; margin: 0 auto; padding: 48px 20px; text-align: center; }
    .invite__box { background: #fff; border: 1px solid #E3E8EE; border-radius: 20px; padding: 34px 24px; }
    .invite__icon { font-size: 52px; }
    .invite h1 { font-size: 28px; margin: 12px 0 8px; color: #0D2D4A; }
    .invite__sub { color: #5B6B7A; line-height: 1.65; }
    .invite__en { color: #93A0AE; font-size: 0.92em; }
    .invite__steps { text-align: left; max-width: 400px; margin: 28px auto 0; color: #34434F; line-height: 1.7; }
    .invite :global(.stores) { justify-content: center; margin-top: 8px; }
  </style>
</Layout>
