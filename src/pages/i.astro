---
import Layout from '../layouts/Layout.astro';
import StoreButtons from '../components/StoreButtons.astro';
import { INVITO } from '../data/pages.js';
// Pagina di atterraggio INVITO AMICI (referral). Il link è
// https://orma.pet/i?c=<codice>. Mostriamo il codice (client-side) e i pulsanti
// store; l'utente installa, si iscrive e inserisce il codice all'iscrizione.
//
// La lingua (SPEC diffusione 9.4). La pagina resta una sola, italiana
// nell'HTML e con autoLang={false}: spostarla su /de/i/ perderebbe il senso
// di un link che arriva da fuori. Lo script qui sotto riscrive i testi
// data-i nella lingua di `?l=` (il QR del cartello per le aree cani la porta:
// e' la lingua in cui il cartello e' stampato), oppure del browser.
const it = INVITO.it;
const title = it.pageTitle;
---
<Layout lang="it" title={title} active="home" noindex={true} autoLang={false}>
  <section class="invite">
    <div class="invite__box">
      <div class="invite__icon" aria-hidden="true">🎁</div>
      <h1 data-i="title">{it.title}</h1>
      <p class="invite__sub">
        <span data-i="sub">{it.sub}</span>
        <span id="invite-en"><br /><span class="invite__en">You've been invited to Orma — the app for lost pets &amp; more.</span></span>
      </p>

      <div class="invite__code" id="codeBox" hidden>
        <span class="invite__code-label" data-i="codeLabel">{it.codeLabel}</span>
        <strong id="code">—</strong>
      </div>

      <StoreButtons lang="it" android="Google Play" ios="App Store" variant="light" />

      <ol class="invite__steps">
        <li data-i="step1">{it.step1}</li>
        <li data-i="step2">{it.step2}</li>
        <li data-i="step3">{it.step3}</li>
      </ol>
    </div>
  </section>

  <script define:vars={{ testi: INVITO }}>
    // La lingua della pagina: prima `?l=` (la lingua del cartello), poi le
    // lingue del browser in ordine di preferenza; nessuna delle 15 =
    // italiano, com'era. Solo textContent: i testi sono nostri, ma non c'e'
    // motivo di trattarli come HTML.
    (function () {
      try {
        var scelta = null;
        var l = (new URLSearchParams(location.search).get('l') || '').toLowerCase().split('-')[0];
        if (testi[l]) scelta = l;
        if (!scelta) {
          var elenco = navigator.languages || [navigator.language || ''];
          for (var i = 0; i < elenco.length && !scelta; i++) {
            var c = String(elenco[i]).toLowerCase().split('-')[0];
            if (testi[c]) scelta = c;
          }
        }
        if (!scelta || scelta === 'it') return;
        var t = testi[scelta];
        document.documentElement.lang = scelta;
        document.title = t.pageTitle;
        document.querySelectorAll('[data-i]').forEach(function (el) {
          var k = el.getAttribute('data-i');
          if (t[k]) el.textContent = t[k];
        });
        // La riga in inglese sotto il testo italiano serve solo a chi legge
        // la pagina in italiano senza capirlo: tradotta, e' un doppione.
        var en = document.getElementById('invite-en');
        if (en) en.hidden = true;
      } catch (e) {}
    })();
  </script>

  <style>
    .invite { max-width: 560px; margin: 0 auto; padding: 48px 20px; text-align: center; }
    .invite__box { background: #fff; border: 1px solid #E3E8EE; border-radius: 20px; padding: 34px 24px; }
    .invite__icon { font-size: 52px; }
    .invite h1 { font-size: 28px; margin: 12px 0 8px; color: #0D2D4A; }
    .invite__sub { color: #5B6B7A; line-height: 1.65; }
    .invite__en { color: #93A0AE; font-size: 0.92em; }
    .invite__code { margin: 24px auto; padding: 14px 20px; border-radius: 14px; background: linear-gradient(90deg,#2A6BA8,#1AB8A0); color: #fff; display: inline-flex; flex-direction: column; gap: 4px; }
    .invite__code-label { font-size: 12px; opacity: .9; }
    .invite__code strong { font-size: 26px; letter-spacing: 3px; }
    .invite__steps { text-align: left; max-width: 400px; margin: 28px auto 0; color: #34434F; line-height: 1.7; }
    .invite :global(.stores) { justify-content: center; margin-top: 8px; }
  </style>

  <script is:inline>
    const q = new URLSearchParams(location.search);
    const c = (q.get('c') || q.get('code') || '').trim().toUpperCase();
    if (c) {
      document.getElementById('code').textContent = c;
      document.getElementById('codeBox').hidden = false;
      // Al tap su "Scarica" copiamo il codice TAGGATO negli appunti PRIMA di
      // aprire lo store: all'avvio l'app lo legge e precompila da solo
      // l'iscrizione (signup_screen.dart). Vale per entrambi i bottoni: dal
      // 23/09/2026 anche quello dell'App Store e' un link, quindi e' preso qui.
      document.querySelectorAll('.stores a.store-btn').forEach((a) => {
        a.addEventListener('click', (e) => {
          e.preventDefault();
          const go = () => { window.location.href = a.href; };
          try { navigator.clipboard.writeText('orma-ref:' + c).then(go, go); }
          catch (err) { go(); }
        });
      });
    }
  </script>
</Layout>
