---
import LegalPage from '../../components/LegalPage.astro';
import { LEGAL } from '../../data/legal.js';
import { ROUTES } from '../../data/site.js';

const lang = 'en';
const doc = LEGAL.privacy;
---
<LegalPage
  lang={lang}
  title={doc.title_en}
  description="How Orma collects and processes your personal data: purposes, legal bases, providers, retention and GDPR rights."
  html={doc.en}
  active="privacy"
  altUrl={ROUTES.privacy.it}
  homeUrl={ROUTES.home[lang]}
/>
