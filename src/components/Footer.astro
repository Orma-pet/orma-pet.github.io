---
import Paw from './Paw.astro';
import { ROUTES, UI, BRAND, testo, urlPagina } from '../data/site.js';

const { lang = 'it' } = Astro.props;
const ui = testo(UI, lang);
const year = 2026;
---
<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__inner">
      <a class="brand" href={urlPagina('home', lang)} aria-label="Orma — home">
        <Paw size={32} variant="tile" />
        <span>Orma</span>
      </a>

      <ul class="footer-links">
        <li><a href={urlPagina('faq', lang)}>{ui.footerLinks.faq}</a></li>
        <li><a href={urlPagina('forOrgs', lang)}>{ui.footerLinks.forOrgs}</a></li>
        <li><a href={urlPagina('childSafety', lang)}>{ui.footerLinks.childSafety}</a></li>
        <li><a href={urlPagina('privacy', lang)}>{ui.footerLinks.privacy}</a></li>
        <li><a href={urlPagina('terms', lang)}>{ui.footerLinks.terms}</a></li>
        <li><a href={urlPagina('deletion', lang)}>{ui.footerLinks.deletion}</a></li>
        <li><a href={`mailto:${BRAND.email}`}>{ui.footerLinks.contact}</a></li>
      </ul>
    </div>

    <div class="footer-bottom">
      <span>{ui.footerTagline}</span>
      <span>{lang === 'it' ? 'Titolare' : 'Owner'}: {BRAND.owner} · {BRAND.email}</span>
      <span>© {year} Orma · {ui.footerColophon}</span>
    </div>
  </div>
</footer>
