---
import { BRAND } from '../data/site.js';
// Android: link reale al Play Store se BRAND.playStoreUrl è valorizzato.
// iOS: ancora "presto" (non pubblicata su App Store).
// props: lang, android (label), ios (label), variant: 'dark' | 'light'
const { lang = 'it', android, ios, variant = 'dark' } = Astro.props;
const cls = variant === 'light' ? 'store-btn store-btn--light' : 'store-btn';
const playUrl = BRAND.playStoreUrl;
const androidSvg = '<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.2 13 11.6l-2.3 2.3L3 6.1c-.2-.4-.3-.9-.3-1.4 0-1 .4-1.9.9-2.5zm10.8 10.8 2.9 2.9-9.8 5.7c-.6.3-1.2.5-1.8.4l8.7-9zM13 12 4.4 3.4l9.6 5.6c.7.4 1.1 1 1.1 1.7 0 .7-.4 1.3-1.1 1.7L13 12zm3.5-3.4 3.2 1.9c.7.4 1.1 1 1.1 1.7 0 .7-.4 1.3-1.1 1.7l-3.2 1.9L14.4 12l2.1-3.4z"/></svg>';
---
<div class="stores">
  {playUrl ? (
    <a class={cls} href={playUrl} target="_blank" rel="noopener" aria-label={android}>
      <Fragment set:html={androidSvg} />
      <span><strong>{android}</strong></span>
    </a>
  ) : (
    <span class={cls} aria-disabled="true" role="img" aria-label={android}>
      <Fragment set:html={androidSvg} />
      <span><strong>{android}</strong></span>
    </span>
  )}
  <span class={cls} aria-disabled="true" role="img" aria-label={ios}>
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.8c0-2.1 1.7-3.1 1.8-3.2-1-1.4-2.5-1.6-3-1.7-1.3-.1-2.5.8-3.2.8-.6 0-1.7-.7-2.8-.7-1.4 0-2.7.8-3.5 2.1-1.5 2.6-.4 6.4 1.1 8.5.7 1 1.6 2.2 2.7 2.1 1.1 0 1.5-.7 2.8-.7s1.7.7 2.8.7c1.2 0 1.9-1 2.6-2 .8-1.2 1.2-2.3 1.2-2.4-.1 0-2.3-.9-2.3-3.5zM14.3 6.3c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.6-1 1.6-.9 2.6 1 .1 1.9-.5 2.5-1.2z"/></svg>
    <span><strong>{ios}</strong></span>
  </span>
</div>
