---
// Icone specie — line-icon coerenti (stesso tratto 1.7, colore brand), no emoji.
// props: species (chiave: dog|cat|rabbit|bird|rodent|reptile|horse|more), size
const { species = 'dog', size = 22 } = Astro.props;

// Ogni voce è il contenuto interno dell'SVG (viewBox 0 0 24 24).
// Stile uniforme: fill="none", stroke currentColor-like via colori brand, tratto 1.7.
const ICONS = {
  // Cane — testa stilizzata con orecchie a goccia
  dog: '<path d="M7 8 5 6v4M17 8l2-2v4" stroke="#2A6BA8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M6.5 10c0-2.5 2.5-4 5.5-4s5.5 1.5 5.5 4c0 3-1.8 7-5.5 7S6.5 13 6.5 10Z" stroke="#2A6BA8" stroke-width="1.7" fill="none" stroke-linejoin="round"/><path d="M12 13v1.5" stroke="#1AB8A0" stroke-width="1.7" stroke-linecap="round"/><circle cx="9.7" cy="10" r=".9" fill="#1AB8A0"/><circle cx="14.3" cy="10" r=".9" fill="#1AB8A0"/>',
  // Gatto — testa con orecchie a punta e baffi
  cat: '<path d="M6 5 8 9M18 5l-2 4" stroke="#2A6BA8" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" fill="none"/><path d="M6 10c0-2 2.7-3.5 6-3.5s6 1.5 6 3.5c0 3.5-2.7 7-6 7S6 13.5 6 10Z" stroke="#2A6BA8" stroke-width="1.7" fill="none" stroke-linejoin="round"/><path d="M12 13l-.7.8M12 13l.7.8M11.3 13.8h1.4" stroke="#1AB8A0" stroke-width="1.4" stroke-linecap="round"/><path d="M5 12.5 7.5 13M19 12.5 16.5 13" stroke="#1AB8A0" stroke-width="1.4" stroke-linecap="round"/><circle cx="9.8" cy="10.5" r=".85" fill="#1AB8A0"/><circle cx="14.2" cy="10.5" r=".85" fill="#1AB8A0"/>',
  // Coniglio — testa con orecchie lunghe
  rabbit: '<path d="M9.5 9C9 6 8.5 3.5 9.8 3.2c1.2-.3 1.7 2.3 1.9 5.3M14.5 9c.5-3 1-5.5-.3-5.8-1.2-.3-1.7 2.3-1.9 5.3" stroke="#2A6BA8" stroke-width="1.7" fill="none" stroke-linecap="round"/><path d="M7.5 13c0-2.5 2-4.2 4.5-4.2S16.5 10.5 16.5 13c0 2.8-2 4.8-4.5 4.8S7.5 15.8 7.5 13Z" stroke="#2A6BA8" stroke-width="1.7" fill="none" stroke-linejoin="round"/><circle cx="10.2" cy="12.8" r=".85" fill="#1AB8A0"/><circle cx="13.8" cy="12.8" r=".85" fill="#1AB8A0"/><path d="M12 14.4v1" stroke="#1AB8A0" stroke-width="1.4" stroke-linecap="round"/>',
  // Uccello — profilo con becco e ala
  bird: '<path d="M5 13a5 5 0 0 1 5-5c2.8 0 4.2 1.7 5 3l3-1-1.6 2.2c.2 3-2.3 6-6.4 6-3.5 0-5-2.3-5-5.2Z" stroke="#2A6BA8" stroke-width="1.7" fill="none" stroke-linejoin="round"/><path d="m17 10 3-1" stroke="#1AB8A0" stroke-width="1.7" stroke-linecap="round"/><path d="M8 13c1.5 1.2 4 1.2 6 0" stroke="#1AB8A0" stroke-width="1.5" fill="none" stroke-linecap="round"/><circle cx="9" cy="11" r=".9" fill="#1AB8A0"/>',
  // Roditore (criceto/topo) — testa rotonda con orecchie tonde
  rodent: '<circle cx="7.5" cy="8" r="2.3" stroke="#2A6BA8" stroke-width="1.7" fill="none"/><circle cx="16.5" cy="8" r="2.3" stroke="#2A6BA8" stroke-width="1.7" fill="none"/><path d="M6 13c0-2.6 2.6-4.3 6-4.3S18 10.4 18 13s-2.6 4.7-6 4.7S6 15.6 6 13Z" stroke="#2A6BA8" stroke-width="1.7" fill="none" stroke-linejoin="round"/><circle cx="10.2" cy="12.5" r=".85" fill="#1AB8A0"/><circle cx="13.8" cy="12.5" r=".85" fill="#1AB8A0"/><path d="M12 14v1M9.5 15l-2 .6M14.5 15l2 .6" stroke="#1AB8A0" stroke-width="1.4" stroke-linecap="round"/>',
  // Rettile (lucertola) — corpo sinuoso con zampe
  reptile: '<path d="M4 12c2 0 2.5-2.5 5-2.5 1.8 0 2.5 1.6 4.2 1.6 1.8 0 2.3-1.6 3.8-1.6 1.6 0 2 1.5 3 1.5" stroke="#2A6BA8" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M4 12c2 .3 2.4 2.6 5 2.6 1.9 0 2.5-1.4 4.2-1.4 1.8 0 2.3 1.4 3.8 1.4 1.4 0 1.9-1.2 3-1.4" stroke="#2A6BA8" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M8 14.4v2M11.5 13.6v2M15 14.4v2" stroke="#1AB8A0" stroke-width="1.5" stroke-linecap="round"/><circle cx="5.4" cy="11.4" r=".8" fill="#1AB8A0"/>',
  // Cavallo — testa e criniera stilizzate
  horse: '<path d="M7 20v-5c0-3 1-5 3-7l1-2 1 1.5c2 .5 4 2 4.5 5l.5 7" stroke="#2A6BA8" stroke-width="1.7" fill="none" stroke-linecap="round" stroke-linejoin="round"/><path d="M11 6c-2 1-3 2.5-3.5 4.5M9.5 8.5 7 8" stroke="#1AB8A0" stroke-width="1.5" fill="none" stroke-linecap="round" stroke-linejoin="round"/><circle cx="11.4" cy="9.4" r=".85" fill="#1AB8A0"/>',
  // e altri — tre puntini in cerchio
  more: '<circle cx="12" cy="12" r="8.2" stroke="#2A6BA8" stroke-width="1.7" fill="none"/><circle cx="8.5" cy="12" r="1.05" fill="#1AB8A0"/><circle cx="12" cy="12" r="1.05" fill="#1AB8A0"/><circle cx="15.5" cy="12" r="1.05" fill="#1AB8A0"/>',
};

const inner = ICONS[species] || ICONS.more;
---
<svg
  width={size}
  height={size}
  viewBox="0 0 24 24"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class="species-icon"
  set:html={inner}
/>
