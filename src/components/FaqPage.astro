---
import Layout from '../layouts/Layout.astro';
import { UI, ROUTES } from '../data/site.js';
import { APP_FAQ } from '../data/appfaq.js';

const { lang = 'it' } = Astro.props;
const ui = UI[lang];
const list = APP_FAQ[lang] || [];
const title = lang === 'it'
  ? 'Domande frequenti su Orma'
  : 'Frequently asked questions about Orma';
const desc = lang === 'it'
  ? "Come funziona la privacy e la posizione sulla mappa? Come si segnala un animale smarrito? Tutte le risposte sull'app Orma."
  : 'How do privacy and the map location work? How do I report a lost pet? All the answers about the Orma app.';
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: list.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout lang={lang} title={`Orma — ${title}`} description={desc} active="faq">
  <section class="legal">
    <div class="wrap">
      <div class="legal__head">
        <a class="legal__back" href={ROUTES.home[lang]}>← {ui.backHome}</a>
        <h1>{title}</h1>
      </div>
      <div class="faq">
        {list.map((f) => (
          <div class="faq__item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Layout>
