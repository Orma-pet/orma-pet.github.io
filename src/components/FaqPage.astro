---
import Layout from '../layouts/Layout.astro';
import { UI, ROUTES, testo, urlPagina } from '../data/site.js';
import { APP_FAQ, FAQ_META } from '../data/appfaq.js';

const { lang = 'it' } = Astro.props;
const ui = testo(UI, lang);
const list = testo(APP_FAQ, lang) || [];
const meta = testo(FAQ_META, lang);
const title = meta.title;
const desc = meta.desc;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: list.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---
<Layout lang={lang} title={`Orma — ${title}`} description={desc} active="faq">
  <section class="legal">
    <div class="wrap">
      <div class="legal__head">
        <a class="legal__back" href={urlPagina('home', lang)}>← {ui.backHome}</a>
        <h1>{title}</h1>
      </div>
      <div class="faq">
        {list.map((f) => (
          <div class="faq__item">
            <h3>{f.q}</h3>
            <p>{f.a}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
  <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
</Layout>
