---
import Layout from '../layouts/Layout.astro';
import StoreButtons from './StoreButtons.astro';
import Paw from './Paw.astro';
import { PET, HOME, ROUTES, UI } from '../data/site.js';

// Landing del QR dei volantini. Il QR punta a https://orma.pet/pet?id=<reportId>.
// La scheda animale è caricata client-side via RPC Supabase (report_detail).
const { lang = 'it' } = Astro.props;
const t = PET[lang];
const h = HOME[lang];
const ui = UI[lang];
const altUrl = lang === 'it' ? ROUTES.pet.en : ROUTES.pet.it;
const homeUrl = ROUTES.home[lang];
const howUrl = ROUTES.howItWorks[lang];

// Config esposta al client via data-attributi sul main (niente segreti: chiave pubblica).
const cfg = {
  lang,
  locale: t.locale,
  notFoundLabel: t.notfoundTitle,
};
---
<Layout
  lang={lang}
  title={t.title}
  active="pet"
  altUrl={altUrl}
  noindex={true}
>
  <section class="pet">
    <div class="wrap pet__inner" id="pet-root" data-lang={lang} data-locale={t.locale}>

      <!-- Stato: CARICAMENTO -->
      <div id="state-loading" class="pet-state">
        <div class="spinner" aria-hidden="true"></div>
        <p>{t.loading}</p>
      </div>

      <!-- Stato: NESSUN ID -->
      <div id="state-noid" class="pet-state" hidden>
        <div class="icon-big" aria-hidden="true">🔍</div>
        <h2>{t.noidTitle}</h2>
        <p>{t.noidText}</p>
        <a class="btn btn--primary" href={homeUrl}>{t.discover}</a>
      </div>

      <!-- Stato: NON TROVATA -->
      <div id="state-notfound" class="pet-state" hidden>
        <div class="icon-big" aria-hidden="true">🐾</div>
        <h2>{t.notfoundTitle}</h2>
        <p>{t.notfoundText}</p>
        <a class="btn btn--primary" href={homeUrl}>{t.discover}</a>
      </div>

      <!-- Stato: ERRORE -->
      <div id="state-error" class="pet-state" hidden>
        <div class="icon-big" aria-hidden="true">📡</div>
        <h2>{t.errorTitle}</h2>
        <p>{t.errorText}</p>
        <button class="btn btn--primary" type="button" onclick="location.reload()">{t.retry}</button>
      </div>

      <!-- Stato: TROVATA (riempito via JS) -->
      <article id="state-found" class="pet-card" hidden>
        <div id="pet-photo-slot"></div>
        <div id="pet-thumbs" class="pet-thumbs"></div>

        <div class="pet-card-body">
          <span id="pet-badge" class="pet-badge"></span>
          <h1 id="pet-title"></h1>
          <p id="pet-desc" class="pet-desc"></p>

          <div id="pet-meta" class="pet-meta"></div>

          <div id="pet-location-note" class="pet-location-note" hidden>
            <span aria-hidden="true">📍</span>
            <span>{t.locationNote}</span>
          </div>

          <div class="pet-app-box">
            <h3>{t.appBoxTitle}</h3>
            <p>{t.appBoxText}</p>
            <div class="stores">
              <span class="store-btn" aria-disabled="true" role="img" aria-label={h.btnAndroid}>
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.6 2.2 13 11.6l-2.3 2.3L3 6.1c-.2-.4-.3-.9-.3-1.4 0-1 .4-1.9.9-2.5zm10.8 10.8 2.9 2.9-9.8 5.7c-.6.3-1.2.5-1.8.4l8.7-9zM13 12 4.4 3.4l9.6 5.6c.7.4 1.1 1 1.1 1.7 0 .7-.4 1.3-1.1 1.7L13 12zm3.5-3.4 3.2 1.9c.7.4 1.1 1 1.1 1.7 0 .7-.4 1.3-1.1 1.7l-3.2 1.9L14.4 12l2.1-3.4z"/></svg>
                <span><strong>{h.btnAndroid}</strong></span>
              </span>
              <a class="btn btn--ghost" href={howUrl} style="border-color:rgba(255,255,255,.7);color:#fff;">{t.discover}</a>
            </div>
          </div>
        </div>
      </article>

    </div>
  </section>
</Layout>

<script is:inline define:vars={{ cfg }}>
  /* ========================================================================
     /pet — landing del QR dei volantini Orma.
     QR: https://orma.pet/pet?id=<reportId>
     Leggiamo l'id, chiamiamo la RPC Supabase report_detail e mostriamo la scheda.
     ======================================================================== */
  (function () {
    'use strict';

    var LANG = cfg.lang || 'it';
    var LOCALE = cfg.locale || 'it-IT';

    // ---- Config Supabase (chiave pubblica) ----
    var SUPABASE_URL = 'https://lztuncwbyjeesmfwvkof.supabase.co';
    var SUPABASE_KEY = 'sb_publishable_1Qfs6LvH3-F-1DTu0yYphg_e5XnoefZ';
    var PHOTO_BASE = SUPABASE_URL + '/storage/v1/object/public/report-photos/';

    // ---- Dizionari enum (it/en) ----
    var TYPE_LABEL = {
      lost: { it: 'Smarrito', en: 'Lost' },
      found: { it: 'Trovato', en: 'Found' },
      abandoned: { it: 'Abbandonato', en: 'Abandoned' }
    };
    var TYPE_BADGE_CLASS = { lost: 'badge-lost', found: 'badge-found', abandoned: 'badge-abandoned' };
    var SPECIES_LABEL = {
      dog: { it: 'Cane', en: 'Dog' },
      cat: { it: 'Gatto', en: 'Cat' },
      bird: { it: 'Uccello', en: 'Bird' },
      rabbit: { it: 'Coniglio', en: 'Rabbit' },
      reptile: { it: 'Rettile', en: 'Reptile' },
      rodent: { it: 'Roditore', en: 'Rodent' },
      horse: { it: 'Cavallo', en: 'Horse' },
      other: { it: 'Altro', en: 'Other' }
    };
    var SEX_LABEL = {
      male: { it: 'Maschio', en: 'Male' },
      female: { it: 'Femmina', en: 'Female' },
      unknown: { it: 'Non noto', en: 'Unknown' }
    };
    var FIELD = {
      species: { it: 'Specie', en: 'Species' },
      breed: { it: 'Razza', en: 'Breed' },
      color: { it: 'Colore', en: 'Colour' },
      sex: { it: 'Sesso', en: 'Sex' },
      age: { it: 'Età circa', en: 'Approx. age' },
      marks: { it: 'Segni particolari', en: 'Distinguishing marks' },
      seen: { it: 'Visto il', en: 'Seen on' },
      months: { it: 'mesi', en: 'months' },
      nodesc: { it: 'Nessuna descrizione fornita.', en: 'No description provided.' }
    };

    function getReportId() {
      var qs = new URLSearchParams(window.location.search);
      var id = qs.get('id');
      if (id) return id.trim();
      var m = window.location.pathname.match(/\/pet\/([^\/?#]+)/);
      return m ? decodeURIComponent(m[1]) : null;
    }

    function showState(id) {
      ['state-loading', 'state-noid', 'state-notfound', 'state-error', 'state-found']
        .forEach(function (s) {
          var el = document.getElementById(s);
          if (el) el.hidden = (s !== id);
        });
    }

    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;');
    }

    function renderReport(r) {
      var L = LANG;

      // Badge tipo
      var badge = document.getElementById('pet-badge');
      var t = r.report_type;
      badge.className = 'pet-badge ' + (TYPE_BADGE_CLASS[t] || 'badge-lost');
      badge.textContent = (TYPE_LABEL[t] ? TYPE_LABEL[t][L] : t);

      // Titolo (titolo o nome animale, con fallback)
      var title = r.title || r.pet_name;
      if (!title) {
        var sp = r.species && SPECIES_LABEL[r.species] ? SPECIES_LABEL[r.species][L] : null;
        title = sp || (TYPE_LABEL[t] ? TYPE_LABEL[t][L] : '');
      }
      document.getElementById('pet-title').textContent = title;

      // Descrizione
      document.getElementById('pet-desc').textContent = r.description || FIELD.nodesc[L];

      // Foto
      var photos = Array.isArray(r.photo_paths) ? r.photo_paths.filter(Boolean) : [];
      var slot = document.getElementById('pet-photo-slot');
      var thumbs = document.getElementById('pet-thumbs');
      thumbs.innerHTML = '';
      if (photos.length) {
        slot.innerHTML = '<img id="pet-main-photo" class="pet-photo" alt="" src="' + esc(PHOTO_BASE + photos[0]) + '">';
        if (photos.length > 1) {
          photos.forEach(function (p, i) {
            var im = document.createElement('img');
            im.src = PHOTO_BASE + p;
            im.alt = '';
            if (i === 0) im.className = 'active';
            im.addEventListener('click', function () {
              document.getElementById('pet-main-photo').src = PHOTO_BASE + p;
              thumbs.querySelectorAll('img').forEach(function (x) { x.classList.remove('active'); });
              im.classList.add('active');
            });
            thumbs.appendChild(im);
          });
        }
      } else {
        slot.innerHTML =
          '<div class="pet-photo-placeholder">' +
            '<svg viewBox="0 0 120 120" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">' +
              '<path d="M42,88 C36,84 34,76 36,68 C38,60 44,55 52,54 C57,53 63,53 68,55 C76,58 82,65 82,73 C82,81 76,88 68,90 C60,92 48,93 42,88 Z" fill="white"/>' +
              '<ellipse cx="38" cy="52" rx="9" ry="11" transform="rotate(-15,38,52)" fill="white"/>' +
              '<ellipse cx="52" cy="41" rx="9" ry="11" transform="rotate(-5,52,41)" fill="white"/>' +
              '<ellipse cx="68" cy="41" rx="9" ry="11" transform="rotate(5,68,41)" fill="white"/>' +
              '<ellipse cx="82" cy="52" rx="9" ry="11" transform="rotate(15,82,52)" fill="white"/>' +
            '</svg>' +
          '</div>';
      }

      // Meta
      var meta = document.getElementById('pet-meta');
      meta.innerHTML = '';
      function addMeta(labelKey, value) {
        if (value == null || value === '') return;
        var item = document.createElement('div');
        item.className = 'pet-meta-item';
        item.innerHTML = '<div class="label">' + esc(FIELD[labelKey][L]) + '</div>' +
                         '<div class="value">' + esc(value) + '</div>';
        meta.appendChild(item);
      }
      addMeta('species', r.species && SPECIES_LABEL[r.species] ? SPECIES_LABEL[r.species][L] : null);
      addMeta('breed', r.breed);
      addMeta('color', r.color);
      addMeta('sex', r.sex && SEX_LABEL[r.sex] ? SEX_LABEL[r.sex][L] : null);
      if (r.approx_age_months != null) addMeta('age', r.approx_age_months + ' ' + FIELD.months[L]);
      addMeta('marks', r.distinguishing_marks);
      var when = r.occurred_at || r.created_at;
      if (when) {
        try {
          var d = new Date(when);
          addMeta('seen', d.toLocaleDateString(LOCALE, { day: 'numeric', month: 'long', year: 'numeric' }));
        } catch (e) {}
      }

      // Nota posizione offuscata
      document.getElementById('pet-location-note').hidden = (r.lat == null || r.lng == null);

      showState('state-found');
    }

    function loadReport(id) {
      showState('state-loading');
      fetch(SUPABASE_URL + '/rest/v1/rpc/report_detail', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          'apikey': SUPABASE_KEY,
          'Authorization': 'Bearer ' + SUPABASE_KEY
        },
        body: JSON.stringify({ in_id: id })
      })
      .then(function (res) {
        if (!res.ok) throw new Error('HTTP ' + res.status);
        return res.json();
      })
      .then(function (data) {
        var row = Array.isArray(data) ? data[0] : data;
        if (!row) { showState('state-notfound'); return; }
        renderReport(row);
      })
      .catch(function (err) {
        console.error('[Orma] report_detail error:', err);
        showState('state-error');
      });
    }

    var id = getReportId();
    if (!id) { showState('state-noid'); return; }
    loadReport(id);
  })();
</script>
