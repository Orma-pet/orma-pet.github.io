---
// Zampa del brand Orma (dal brand kit). Riusabile.
// props: size (px), variant: 'tile' (zampa bianca su tile a gradiente) |
//        'solid' (zampa a gradiente, no sfondo) | 'white' (zampa bianca piena)
const { size = 32, variant = 'tile', class: className = '' } = Astro.props;
// id univoco per il gradiente, così più istanze non collidono
const gid = 'pawg-' + Math.random().toString(36).slice(2, 9);
---
<svg
  width={size}
  height={size}
  viewBox="0 0 120 120"
  xmlns="http://www.w3.org/2000/svg"
  aria-hidden="true"
  class={className}
>
  <defs>
    <linearGradient id={gid} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0%" stop-color="#2A6BA8" />
      <stop offset="100%" stop-color="#1AB8A0" />
    </linearGradient>
  </defs>

  {variant === 'tile' && (
    <>
      <rect width="120" height="120" rx="28" fill={`url(#${gid})`} />
      <path d="M42,88 C36,84 34,76 36,68 C38,60 44,55 52,54 C57,53 63,53 68,55 C76,58 82,65 82,73 C82,81 76,88 68,90 C60,92 48,93 42,88 Z" fill="white" />
      <ellipse cx="38" cy="52" rx="9" ry="11" transform="rotate(-15,38,52)" fill="white" />
      <ellipse cx="52" cy="41" rx="9" ry="11" transform="rotate(-5,52,41)" fill="white" />
      <ellipse cx="68" cy="41" rx="9" ry="11" transform="rotate(5,68,41)" fill="white" />
      <ellipse cx="82" cy="52" rx="9" ry="11" transform="rotate(15,82,52)" fill="white" />
      <path d="M60,82 C60,82 52,76 52,71 C52,68 54.5,66 57,67.5 C58.5,68.4 60,70 60,70 C60,70 61.5,68.4 63,67.5 C65.5,66 68,68 68,71 C68,76 60,82 60,82 Z" fill={`url(#${gid})`} />
    </>
  )}

  {variant === 'solid' && (
    <>
      <path d="M42,88 C36,84 34,76 36,68 C38,60 44,55 52,54 C57,53 63,53 68,55 C76,58 82,65 82,73 C82,81 76,88 68,90 C60,92 48,93 42,88 Z" fill={`url(#${gid})`} />
      <ellipse cx="38" cy="52" rx="9" ry="11" transform="rotate(-15,38,52)" fill={`url(#${gid})`} />
      <ellipse cx="52" cy="41" rx="9" ry="11" transform="rotate(-5,52,41)" fill={`url(#${gid})`} />
      <ellipse cx="68" cy="41" rx="9" ry="11" transform="rotate(5,68,41)" fill={`url(#${gid})`} />
      <ellipse cx="82" cy="52" rx="9" ry="11" transform="rotate(15,82,52)" fill={`url(#${gid})`} />
      <path d="M60,82 C60,82 52,76 52,71 C52,68 54.5,66 57,67.5 C58.5,68.4 60,70 60,70 C60,70 61.5,68.4 63,67.5 C65.5,66 68,68 68,71 C68,76 60,82 60,82 Z" fill="white" />
    </>
  )}

  {variant === 'white' && (
    <>
      <path d="M42,88 C36,84 34,76 36,68 C38,60 44,55 52,54 C57,53 63,53 68,55 C76,58 82,65 82,73 C82,81 76,88 68,90 C60,92 48,93 42,88 Z" fill="white" />
      <ellipse cx="38" cy="52" rx="9" ry="11" transform="rotate(-15,38,52)" fill="white" />
      <ellipse cx="52" cy="41" rx="9" ry="11" transform="rotate(-5,52,41)" fill="white" />
      <ellipse cx="68" cy="41" rx="9" ry="11" transform="rotate(5,68,41)" fill="white" />
      <ellipse cx="82" cy="52" rx="9" ry="11" transform="rotate(15,82,52)" fill="white" />
      <path d="M60,82 C60,82 52,76 52,71 C52,68 54.5,66 57,67.5 C58.5,68.4 60,70 60,70 C60,70 61.5,68.4 63,67.5 C65.5,66 68,68 68,71 C68,76 60,82 60,82 Z" fill="rgba(42,107,168,0.55)" />
    </>
  )}
</svg>
