---
// Tre passi, in stile editoriale (numeri grandi a gradiente).
// props: steps — array { t, x } già tradotti.
const { steps = [] } = Astro.props;
---
<div class="steps">
  {steps.map((s, i) => (
    <div class="step">
      <div class="step__num grad-text">{String(i + 1).padStart(2, '0')}</div>
      <div>
        <h3>{s.t}</h3>
        <p>{s.x}</p>
      </div>
    </div>
  ))}
</div>
