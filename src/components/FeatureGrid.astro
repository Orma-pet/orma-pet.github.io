---
// Griglia funzionalità (riusata da home e pagina /funzionalita).
// props: feats — array { t, x } (già tradotti). Le icone sono fisse, in ordine.
const { feats = [] } = Astro.props;

// Icone line-style coerenti (stesso tratto 1.8), nell'ordine dei dati.
const icons = [
  // segnala (smarrito/trovato/abbandonato) — pin con +
  '<path d="M12 21s7-6.3 7-11a7 7 0 1 0-14 0c0 4.7 7 11 7 11Z" fill="none" stroke="#2A6BA8" stroke-width="1.8" stroke-linejoin="round"/><path d="M12 7v6M9 10h6" stroke="#1AB8A0" stroke-width="1.8" stroke-linecap="round"/>',
  // mappa con privacy
  '<path d="M9 4 4 6v14l5-2 6 2 5-2V4l-5 2-6-2Z" fill="none" stroke="#1AB8A0" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 4v14M15 6v14" stroke="#2A6BA8" stroke-width="1.8"/>',
  // avvisi
  '<path d="M6 9a6 6 0 1 1 12 0c0 5 2 6 2 6H4s2-1 2-6Z" fill="none" stroke="#2A6BA8" stroke-width="1.8" stroke-linejoin="round"/><path d="M10 19a2 2 0 0 0 4 0" fill="none" stroke="#1AB8A0" stroke-width="1.8"/>',
  // foto / avvistamenti
  '<rect x="3" y="6" width="18" height="13" rx="2" fill="none" stroke="#2A6BA8" stroke-width="1.8"/><path d="M8 6l1.5-2h5L16 6" fill="none" stroke="#1AB8A0" stroke-width="1.8"/><circle cx="12" cy="12.5" r="3" fill="none" stroke="#1AB8A0" stroke-width="1.8"/>',
  // corrispondenze / microchip
  '<rect x="7" y="7" width="10" height="10" rx="2" fill="none" stroke="#2A6BA8" stroke-width="1.8"/><path d="M10 4v3M14 4v3M10 17v3M14 17v3M4 10h3M4 14h3M17 10h3M17 14h3" stroke="#1AB8A0" stroke-width="1.8"/>',
  // chat
  '<path d="M4 5h16v10H9l-4 4V5Z" fill="none" stroke="#2A6BA8" stroke-width="1.8" stroke-linejoin="round"/><path d="M8 9h8M8 12h5" stroke="#1AB8A0" stroke-width="1.8"/>',
  // volantino PDF + QR
  '<path d="M6 3h8l4 4v14H6V3Z" fill="none" stroke="#2A6BA8" stroke-width="1.8" stroke-linejoin="round"/><path d="M14 3v4h4" fill="none" stroke="#2A6BA8" stroke-width="1.8" stroke-linejoin="round"/><path d="M9 11h2v2H9zM9 15h2v2H9M13 11h2v2h-2zM13 15h2" stroke="#1AB8A0" stroke-width="1.6" stroke-linecap="round"/>',
  // adozioni / casa-cuore
  '<path d="M4 11 12 4l8 7" fill="none" stroke="#2A6BA8" stroke-width="1.8" stroke-linejoin="round"/><path d="M6 10v9h12v-9" fill="none" stroke="#2A6BA8" stroke-width="1.8"/><path d="M12 16.5s-2.2-1.5-2.2-3c0-.9.7-1.4 1.4-1 .4.2.8.7.8.7s.4-.5.8-.7c.7-.4 1.4.1 1.4 1 0 1.5-2.2 3-2.2 3Z" fill="#1AB8A0"/>',
  // tag QR e collare
  '<rect x="4" y="4" width="7" height="7" rx="1" fill="none" stroke="#2A6BA8" stroke-width="1.8"/><rect x="4" y="13" width="7" height="7" rx="1" fill="none" stroke="#2A6BA8" stroke-width="1.8"/><rect x="13" y="4" width="7" height="7" rx="1" fill="none" stroke="#1AB8A0" stroke-width="1.8"/><path d="M13 14h3v3M20 13v7M16 20h1" stroke="#1AB8A0" stroke-width="1.8" stroke-linecap="round"/>',
  // libretto sanitario
  '<rect x="4" y="4" width="16" height="16" rx="2" fill="none" stroke="#2A6BA8" stroke-width="1.8"/><path d="M4 8h16" stroke="#2A6BA8" stroke-width="1.8"/><path d="M12 11v6M9 14h6" stroke="#1AB8A0" stroke-width="1.8" stroke-linecap="round"/>',
  // veterinari e canili (scudo + croce)
  '<path d="M12 3 5 6v6c0 4 3 6.5 7 9 4-2.5 7-5 7-9V6l-7-3Z" fill="none" stroke="#2A6BA8" stroke-width="1.8" stroke-linejoin="round"/><path d="M12 8.5v5M9.5 11h5" stroke="#1AB8A0" stroke-width="1.8" stroke-linecap="round"/>',
  // modalità cercatore (lente)
  '<circle cx="11" cy="11" r="6" fill="none" stroke="#2A6BA8" stroke-width="1.8"/><path d="m16 16 4 4" stroke="#2A6BA8" stroke-width="1.8" stroke-linecap="round"/><path d="M11 9.4c-.6 0-1 .5-1 1 0 .8 1 1.6 1 1.6s1-.8 1-1.6c0-.5-.4-1-1-1Z" fill="#1AB8A0"/>',
];
---
<div class="features">
  {feats.map((f, i) => (
    <article class="feature">
      <div class="feature__mark">
        <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true" set:html={icons[i % icons.length]} />
      </div>
      <span class="feature__idx">{String(i + 1).padStart(2, '0')}</span>
      <h3>{f.t}</h3>
      <p>{f.x}</p>
    </article>
  ))}
</div>
