---
import Layout from '../layouts/Layout.astro';
import StoreButtons from './StoreButtons.astro';
import { UI, HOME, ROUTES } from '../data/site.js';
import { GUIDES } from '../data/guides.js';

// Pagina di una singola guida. props: lang, guide (oggetto guida).
const { lang = 'it', guide } = Astro.props;
const ui = UI[lang];
const h = HOME[lang];
const d = guide[lang];
const base = ROUTES.guides[lang];
const others = GUIDES.filter((g) => g.slug[lang] !== guide.slug[lang]).slice(0, 4);

const faqList = (guide.faq && guide.faq[lang]) || [];
const faqLd = faqList.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqList.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    }
  : null;
---
<Layout
  lang={lang}
  title={`Orma — ${d.title}`}
  description={d.metaDesc}
  active="guides"
>
  <section class="legal">
    <div class="wrap">
      <div class="legal__head">
        <a class="legal__back" href={base}>← {ui.allGuides}</a>
        <h1>{d.title}</h1>
      </div>

      <div class="prose" set:html={d.html} />

      {faqList.length > 0 && (
        <div class="faq">
          <h2>{ui.faqTitle}</h2>
          {faqList.map((f) => (
            <div class="faq__item">
              <h3>{f.q}</h3>
              <p>{f.a}</p>
            </div>
          ))}
        </div>
      )}

      <div class="cta" style="margin-top:2.6rem;">
        <h2>{ui.guideCtaTitle}</h2>
        <p>{ui.guideCtaText}</p>
        <StoreButtons lang={lang} android={h.btnAndroid} ios={h.btnIos} variant="dark" />
      </div>

      <nav class="guide-more" aria-label={ui.allGuides}>
        <h2>{ui.allGuides}</h2>
        <ul>
          {others.map((g) => (
            <li>
              <a href={base + g.slug[lang] + '/'}>{g[lang].title}</a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  </section>

  {faqLd && <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />}
</Layout>
